countLabel.Font = Enum.Font.GothamMedium
countLabel.TextSize = 10
countLabel.TextColor3 = Color3.fromRGB(150, 150, 155)
countLabel.TextXAlignment = Enum.TextXAlignment.Left
countLabel.Text = "removed: 0"
countLabel.Parent = frame

local function refreshToggleVisual()
    if enabled then
        toggleBtn.Text = "ON"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(30, 90, 50)
    else
        toggleBtn.Text = "OFF"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(70, 30, 30)
    end

    countLabel.Text = "removed: " .. removedCount
end

local function bumpCount()
    removedCount += 1
    countLabel.Text = "removed: " .. removedCount
end

local function killField(obj)
    if obj and obj.Parent then
        obj:Destroy()
        bumpCount()
    end
end

local function purgeDeep(root)
    for _, d in ipairs(root:GetDescendants()) do
        if TARGETS[d.Name] then
            killField(d)
        end
    end
end

local function watchBrick(brick)
    if not brick or not brick:IsA("Instance") then
        return
    end

    if not brick:IsDescendantOf(workspace) then
        return
    end

    purgeDeep(brick)

    table.insert(conns, brick.DescendantAdded:Connect(function(c)
        if not enabled then return end

        if TARGETS[c.Name] then
            task.defer(killField, c)
        end
    end))
end

local function watchPlayerFolder(folder)
    if not folder then return end

    for _, brick in ipairs(folder:GetChildren()) do
        watchBrick(brick)
    end

    table.insert(conns, folder.ChildAdded:Connect(function(b)
        if not enabled then return end
        watchBrick(b)
    end))
end

local function startScan()
    if not enabled then return end

    local bricks = workspace:FindFirstChild("Bricks")

    if not bricks then
        table.insert(conns, workspace.ChildAdded:Connect(function(c)
            if c.Name == "Bricks" and enabled then
                startScan()
            end
        end))
        return
    end

    for _, folder in ipairs(bricks:GetChildren()) do
        watchPlayerFolder(folder)
    end

    table.insert(conns, bricks.ChildAdded:Connect(function(f)
        if not enabled then return end
        watchPlayerFolder(f)
    end))
end

local function stopScan()
    for _, c in ipairs(conns) do
        pcall(function()
            c:Disconnect()
        end)
    end

    conns = {}
end

toggleBtn.MouseButton1Click:Connect(function()
    enabled = not enabled
    refreshToggleVisual()

    if enabled then
        startScan()
    else
        stopScan()
    end
end)

do
    local dragging, dragStart, startPos

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPos = frame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            local delta = input.Position - dragStart

            frame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

refreshToggleVisual()
print("I cracked Lucia every day")
